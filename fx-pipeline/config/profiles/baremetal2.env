# ==============================================================================
# Profile: baremetal2
# Environment: Vultr Bare Metal (new/faster server), Rocky Linux 9
# Execution Mode: native (JVM processes launched directly via start.sh)
# Use: ./scripts/run_benchmark.sh --profile baremetal2 <rate> <count>
#
# This profile mirrors 'baremetal' but with all performance fixes applied:
#   - THP removed (no khugepaged mmap_lock contention)
#   - cpucore system properties aligned with taskset cpuset assignments
#   - Queue on /dev/shm (always RAM-backed on Linux)
#
# OS tuning required (run scripts/setup_baremetal_os.sh before benchmarking):
#   isolcpus=1-5 nohz_full=1-5 rcu_nocbs=1-5
#   intel_idle.max_cstate=0 processor.max_cstate=0 idle=poll
#   SMT disabled, CPU governor=performance, THP=madvise
# ==============================================================================

# --- Identity ---
FX_ENV_LABEL="baremetal2_vultr"
FX_EXECUTION_MODE="native"
FX_CPU_PROFILE="isolated"

# --- HLog Paths ---
FX_HLOG_DIR="/tmp/fx-telemetry"
FX_HOST_HLOG_DIR="/tmp/fx-telemetry"

# --- Queue ---
# /dev/shm is always a tmpfs RAM-backed filesystem on Linux.
# Do NOT use /tmp — it may be a regular ext4 partition depending on provisioning.
FX_QUEUE_DIR="/dev/shm/fx-queues"

# --- JVM ---
FX_WAIT_STRATEGY="busyspin"
# -XX:+UseTransparentHugePages is intentionally EXCLUDED: it enables khugepaged,
# which acquires mmap_lock on Chronicle Queue mmap segments and causes 1-50ms
# latency spikes. The fixed QueuePreToucher handles page pre-faulting instead.
#
# -Dfx.serv-*.cpucore aligns AffinityLock with the taskset cpuset assignments
# (FX_SERV_*_CPUSET below). Without these, AffinityLock attempts to pin to cores
# 0-3 but taskset restricts the JVM to cores 1-4, causing a silent failure where
# AffinityLock reports "CPU affinity unavailable" and provides no benefit.
FX_JVM_OPTS_OVERRIDE="-XX:+UseZGC -XX:+ZGenerational -XX:+AlwaysPreTouch -Xmx4G -Xms4G -XX:ActiveProcessorCount=2 -XX:ConcGCThreads=1 -XX:ParallelGCThreads=1 -XX:CICompilerCount=2 -Dfx.serv-0.cpucore=1 -Dfx.serv-a.cpucore=2 -Dfx.serv-b.cpucore=3 -Dfx.serv-c.cpucore=4"

# --- CPU Pinning ---
# Each service is pinned to a dedicated isolated physical core via taskset.
# Core 0 is left free for OS scheduler, SSH, IRQs.
# The -Dfx.serv-*.cpucore properties above must match these values exactly.
FX_SERV_0_CPUSET="1"
FX_SERV_A_CPUSET="2"
FX_SERV_B_CPUSET="3"
FX_SERV_C_CPUSET="4"
FX_BENCHMARK_CPUSET="5"
FX_TELEMETRY_CPUSET=""

# --- Timing ---
FX_WARMUP_SECONDS="20"
FX_STARTUP_TIMEOUT_SECONDS="30"
FX_STOP_TIMEOUT_SECONDS="40"

# --- Build ---
FX_SKIP_BUILD="false"
