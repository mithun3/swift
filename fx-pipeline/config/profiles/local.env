FX_ENV_LABEL="local"
FX_EXECUTION_MODE="native"
FX_HLOG_DIR="/tmp"
FX_QUEUE_DIR="/tmp/fx-queues"
FX_WAIT_STRATEGY="busyspin"
FX_JVM_OPTS_OVERRIDE="-XX:+UseZGC -XX:+ZGenerational -XX:+AlwaysPreTouch -Xmx4G -Xms4G"
FX_SERV_0_CPUSET="1"
FX_SERV_A_CPUSET="2"
FX_SERV_B_CPUSET="3"
FX_SERV_C_CPUSET="4"
FX_BENCHMARK_CPUSET="5"
