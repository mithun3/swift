# ==============================================================================
# Profile: local
# Environment: macOS native (Apple M2 Max, 12 logical cores)
# Execution Mode: native (JVM processes launched directly via start.sh)
# Use: ./scripts/run_benchmark.sh --profile local <rate> <count>
# Notes: taskset is unavailable on macOS; CPU pinning has no effect.
#        THP is not supported on macOS; omitted from JVM opts.
# ==============================================================================

# --- Identity ---
FX_ENV_LABEL="local"
FX_EXECUTION_MODE="native"
FX_CPU_PROFILE="host"

# --- HLog Paths ---
# FX_HLOG_DIR: path where .hlog files are written by running services.
#              For local macOS, defaults match the JVM's default telemetry path.
FX_HLOG_DIR="/tmp"
# FX_HOST_HLOG_DIR: for native mode this is the same as FX_HLOG_DIR.
#                   generate_benchmark_report.sh uses HOST_HLOG_DIR="${FX_HOST_HLOG_DIR:-$FX_HLOG_DIR}".
FX_HOST_HLOG_DIR="/tmp"

# --- Queue ---
FX_QUEUE_DIR="/tmp/fx-queues"

# --- JVM ---
FX_WAIT_STRATEGY="busyspin"
FX_JVM_OPTS_OVERRIDE="-XX:+UseZGC -XX:+ZGenerational -XX:+AlwaysPreTouch -Xmx4G -Xms4G -XX:ActiveProcessorCount=2 -XX:ConcGCThreads=1 -XX:ParallelGCThreads=1 -XX:CICompilerCount=2"

# --- CPU Pinning ---
# taskset is Linux-only; these values are set for manifest recording accuracy
# but have no scheduling effect on macOS.
FX_SERV_0_CPUSET="1"
FX_SERV_A_CPUSET="2"
FX_SERV_B_CPUSET="3"
FX_SERV_C_CPUSET="4"
FX_BENCHMARK_CPUSET="5"
FX_TELEMETRY_CPUSET=""

# --- Timing ---
FX_WARMUP_SECONDS="20"
FX_STARTUP_TIMEOUT_SECONDS="30"
FX_STOP_TIMEOUT_SECONDS="40"

# --- Build ---
# Not applicable for native mode (no Docker build step)
FX_SKIP_BUILD="false"
