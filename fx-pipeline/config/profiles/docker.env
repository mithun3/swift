# ==============================================================================
# Profile: docker
# Environment: macOS Docker Desktop (Apple M2 Max, 12-core ARM VM)
# Execution Mode: docker (containers via docker-compose)
# Use: ./scripts/run_benchmark.sh --profile docker <rate> <count>
# ==============================================================================

# --- Identity ---
FX_ENV_LABEL="docker"
FX_EXECUTION_MODE="docker"
FX_CPU_PROFILE="host"

# --- HLog Paths ---
# FX_HLOG_DIR: container-side path. Used by docker_runner.sh to clear histograms
#              between warmup and measurement via 'docker compose exec'.
#              Must match the bind mount target in docker-compose.yml.
FX_HLOG_DIR="/tmp/fx-telemetry"
# FX_HOST_HLOG_DIR: host-side path. The bind mount source (./fx-telemetry:/tmp/fx-telemetry).
#                   generate_benchmark_report.sh reads .hlog files from here on the host.
FX_HOST_HLOG_DIR="fx-telemetry"

# --- Queue ---
FX_QUEUE_DIR="/dev/shm/fx-queues"

# --- JVM ---
FX_WAIT_STRATEGY="busyspin"
FX_JVM_OPTS_OVERRIDE="-XX:+UseZGC -XX:+ZGenerational -XX:+AlwaysPreTouch -XX:+UseTransparentHugePages -Xmx4G -Xms4G -XX:ActiveProcessorCount=2 -XX:ConcGCThreads=1 -XX:ParallelGCThreads=1 -XX:CICompilerCount=2 -Dfx.queue.base.dir=/dev/shm/fx-queues"

# --- CPU Pinning (cores within the Docker Desktop Linux VM) ---
# macOS Docker Desktop does not provide true physical core isolation;
# these are VM-virtual CPUs. Pinning still provides scheduling affinity within the VM.
FX_SERV_0_CPUSET="1"
FX_SERV_A_CPUSET="2"
FX_SERV_B_CPUSET="3"
FX_SERV_C_CPUSET="4"
FX_BENCHMARK_CPUSET="5"
FX_TELEMETRY_CPUSET=""

# --- Timing ---
FX_WARMUP_SECONDS="20"
FX_STARTUP_TIMEOUT_SECONDS="30"
FX_STOP_TIMEOUT_SECONDS="40"

# --- Build ---
# Set to "true" to skip docker image rebuild (faster iteration)
FX_SKIP_BUILD="false"
