# ==============================================================================
# Profile: ec2
# Environment: AWS EC2 (bare-metal or dedicated, Rocky Linux 9, SMT disabled)
# Execution Mode: native (JVM processes launched directly via start.sh)
# Use: ./scripts/run_benchmark.sh --profile ec2 <rate> <count>
# Notes: Same OS tuning as baremetal profile. Requires isolcpus=1-5 nohz_full=1-5
#        rcu_nocbs=1-5 intel_idle.max_cstate=0 idle=poll (see PERFORMANCE_TUNING.md)
# ==============================================================================

# --- Identity ---
FX_ENV_LABEL="ec2"
FX_EXECUTION_MODE="native"
FX_CPU_PROFILE="isolated"

# --- HLog Paths ---
# FX_HLOG_DIR: path where .hlog files are written by running services.
FX_HLOG_DIR="/tmp/fx-telemetry"
# FX_HOST_HLOG_DIR: for native mode this is the same as FX_HLOG_DIR.
#                   generate_benchmark_report.sh uses HOST_HLOG_DIR="${FX_HOST_HLOG_DIR:-$FX_HLOG_DIR}".
FX_HOST_HLOG_DIR="/tmp/fx-telemetry"

# --- Queue ---
FX_QUEUE_DIR="/tmp/fx-queues"

# --- JVM ---
FX_WAIT_STRATEGY="busyspin"
FX_JVM_OPTS_OVERRIDE="-XX:+UseZGC -XX:+ZGenerational -XX:+AlwaysPreTouch -XX:+UseTransparentHugePages -Xmx4G -Xms4G"

# --- CPU Pinning ---
# Each service is pinned to a dedicated isolated physical core via taskset.
# Core 0 is left free for OS scheduler, SSH, IRQs.
FX_SERV_0_CPUSET="1"
FX_SERV_A_CPUSET="2"
FX_SERV_B_CPUSET="3"
FX_SERV_C_CPUSET="4"
FX_BENCHMARK_CPUSET="5"
FX_TELEMETRY_CPUSET=""

# --- Timing ---
FX_WARMUP_SECONDS="20"
FX_STARTUP_TIMEOUT_SECONDS="30"
FX_STOP_TIMEOUT_SECONDS="40"

# --- Build ---
# Not applicable for native mode (no Docker build step)
FX_SKIP_BUILD="false"
