<?xml version="1.0" encoding="UTF-8"?>
<!--
    Parent POM for the FX Ultra-Low-Latency Trading Pipeline.

    Design Philosophy:
    ─────────────────
    This multi-module Maven project follows LMAX Disruptor principles and mechanical
    sympathy. All modules compile to Java 21 bytecode with strict compiler flags.
    Chronicle Queue and Agrona are the only external runtime dependencies, keeping
    the dependency graph minimal and avoiding classpath bloat that would increase
    JVM startup time and JIT warm-up time.

    Module Layout:
      common  – Shared flyweight events, queue factories, abstract event loops
      serv-0  – FIX ingestion gateway (queue-a producer)
      serv-a  – Risk validation processor (queue-a consumer / queue-b producer)
      serv-b  – Pricing / matching engine  (queue-b consumer / queue-c producer)
      serv-c  – Persistence / egress layer  (queue-c consumer)
      test    – Integration test harness (spins up full pipeline in-process)
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.fx</groupId>
    <artifactId>fx-pipeline</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>FX Ultra-Low-Latency Pipeline</name>
    <description>
        A 4-service, Chronicle-Queue-backed, LMAX-Disruptor-inspired FX trading
        pipeline targeting sub-millisecond end-to-end latency and 10M+ events/sec
        throughput. Zero heap allocations on the critical path.
    </description>

    <!-- ═══════════════════════════════════════════════════════════════════
         Module declarations – Maven resolves inter-module dependencies in
         topological order, so common is always built first.
         ═══════════════════════════════════════════════════════════════════ -->
    <modules>
        <module>common</module>
        <module>serv-0</module>
        <module>serv-a</module>
        <module>serv-b</module>
        <module>serv-c</module>
        <module>client</module>
        <module>test</module>
    </modules>

    <!-- ═══════════════════════════════════════════════════════════════════
         Global properties – version pins for all dependencies and plugins.
         Centralised here so updating a library version is a one-line change.
         ═══════════════════════════════════════════════════════════════════ -->
    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Chronicle / OpenHFT stack – date-versioned scheme -->
        <chronicle.queue.version>2026.6</chronicle.queue.version>
        <chronicle.affinity.version>2026.2</chronicle.affinity.version>

        <!-- Agrona: lock-free off-heap data structures (ManyToOneConcurrentArrayQueue etc.) -->
        <agrona.version>2.5.0</agrona.version>

        <!-- Test stack -->
        <junit.version>5.11.4</junit.version>
        <mockito.version>5.14.2</mockito.version>
        <h2.version>2.3.232</h2.version>

        <!-- Maven plugin versions -->
        <maven.compiler.plugin.version>3.13.0</maven.compiler.plugin.version>
        <maven.surefire.plugin.version>3.5.2</maven.surefire.plugin.version>
        <maven.failsafe.plugin.version>3.5.2</maven.failsafe.plugin.version>
        <jacoco.plugin.version>0.8.12</jacoco.plugin.version>
    </properties>

    <!-- ═══════════════════════════════════════════════════════════════════
         Dependency Management – all child modules inherit these versions;
         they only need to declare the groupId/artifactId (no version tag).
         ═══════════════════════════════════════════════════════════════════ -->
    <dependencyManagement>
        <dependencies>

            <!-- ── Chronicle Queue ───────────────────────────────────────
                 Off-heap, memory-mapped, append-only, persistent queue.
                 Chronicle Queue guarantees sequential writes and reads via
                 memory-mapped files, providing near-zero latency IPC that
                 bypasses the JVM GC heap entirely.
                 ─────────────────────────────────────────────────────── -->
            <dependency>
                <groupId>net.openhft</groupId>
                <artifactId>chronicle-queue</artifactId>
                <version>${chronicle.queue.version}</version>
            </dependency>

            <!-- ── Java Thread Affinity ──────────────────────────────────
                 JNI-based CPU pinning. AffinityLock.acquireLock(cpuId)
                 binds the calling OS thread to a specific physical core,
                 eliminating scheduler-induced cache misses and context
                 switches on the critical trading path.
                 ─────────────────────────────────────────────────────── -->
            <dependency>
                <groupId>net.openhft</groupId>
                <artifactId>affinity</artifactId>
                <version>${chronicle.affinity.version}</version>
            </dependency>

            <!-- ── Agrona ────────────────────────────────────────────────
                 Real's lock-free data structures (Aeron project). Provides
                 cache-line padded AtomicLong sequences, ManyToOneConcurrent
                 ArrayQueue for the error channel, and UnsafeBuffer for
                 zero-copy direct memory access.
                 ─────────────────────────────────────────────────────── -->
            <dependency>
                <groupId>org.agrona</groupId>
                <artifactId>agrona</artifactId>
                <version>${agrona.version}</version>
            </dependency>

            <!-- ── Internal module dependencies ─────────────────────────
                 Each service module declares a compile dependency on common.
                 ─────────────────────────────────────────────────────── -->
            <dependency>
                <groupId>com.fx</groupId>
                <artifactId>common</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- ── Test dependencies ─────────────────────────────────── -->
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-core</artifactId>
                <version>${mockito.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-junit-jupiter</artifactId>
                <version>${mockito.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>com.h2database</groupId>
                <artifactId>h2</artifactId>
                <version>${h2.version}</version>
                <scope>test</scope>
            </dependency>
            <!-- common module available in test scope for integration tests -->
            <dependency>
                <groupId>com.fx</groupId>
                <artifactId>common</artifactId>
                <version>${project.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>com.fx</groupId>
                <artifactId>serv-0</artifactId>
                <version>${project.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>com.fx</groupId>
                <artifactId>serv-a</artifactId>
                <version>${project.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>com.fx</groupId>
                <artifactId>serv-b</artifactId>
                <version>${project.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>com.fx</groupId>
                <artifactId>serv-c</artifactId>
                <version>${project.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- ═══════════════════════════════════════════════════════════════════
         Build Plugin Management
         ═══════════════════════════════════════════════════════════════════ -->
    <build>
        <pluginManagement>
            <plugins>

                <!-- Compiler plugin: Java 21. add-exports are runtime-only (Chronicle Wire reflects
                     into internal JDK APIs at runtime, not compile time). Compiler uses release=21. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven.compiler.plugin.version}</version>
                    <configuration>
                        <source>${java.version}</source>
                        <target>${java.version}</target>
                        <release>${java.version}</release>
                    </configuration>
                </plugin>

                <!-- Surefire: add-opens for Chronicle runtime reflection, ZGC for consistency with production -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven.surefire.plugin.version}</version>
                    <configuration>
                        <argLine>
                            --add-exports=java.base/jdk.internal.ref=ALL-UNNAMED
                            --add-exports=java.base/sun.nio.ch=ALL-UNNAMED
                            --add-exports=jdk.unsupported/sun.misc=ALL-UNNAMED
                            --add-opens=java.base/java.lang=ALL-UNNAMED
                            --add-opens=java.base/java.lang.reflect=ALL-UNNAMED
                            --add-opens=java.base/java.io=ALL-UNNAMED
                            --add-opens=java.base/java.util=ALL-UNNAMED
                            -XX:+UseZGC
                            -Xmx512m -Xms512m
                            -XX:+AlwaysPreTouch
                            -XX:+DisableExplicitGC
                        </argLine>
                        <useModulePath>false</useModulePath>
                    </configuration>
                </plugin>

                <!-- ── Failsafe (integration tests) ─────────────────── -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven.failsafe.plugin.version}</version>
                    <configuration>
                        <argLine>
                            --add-exports=java.base/jdk.internal.ref=ALL-UNNAMED
                            --add-exports=java.base/sun.nio.ch=ALL-UNNAMED
                            --add-exports=jdk.unsupported/sun.misc=ALL-UNNAMED
                            --add-opens=java.base/java.lang=ALL-UNNAMED
                            --add-opens=java.base/java.lang.reflect=ALL-UNNAMED
                            --add-opens=java.base/java.io=ALL-UNNAMED
                            --add-opens=java.base/java.util=ALL-UNNAMED
                            -XX:+UseZGC
                            -Xmx512m -Xms512m
                            -XX:+AlwaysPreTouch
                        </argLine>
                        <useModulePath>false</useModulePath>
                    </configuration>
                    <executions>
                        <execution>
                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!-- ── JaCoCo (coverage) ─────────────────────────────── -->
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.plugin.version}</version>
                    <executions>
                        <execution>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>report</id>
                            <phase>test</phase>
                            <goals>
                                <goal>report</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

            </plugins>
        </pluginManagement>
    </build>

</project>
